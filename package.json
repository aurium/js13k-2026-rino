{
  "name": "js13k-2026-rino",
  "version": "0.0.1",
  "description": "Rino — Finding Love",
  "main": "index.html",
  "author": "Aurélio Heckert",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "asbuild:debug": "asc src/assembly/index.ts --target debug -Osize",
    "asbuild:release": "asc src/assembly/index.ts --target release -Osize --bindings esm",
    "asbuild": "yarn asbuild:debug && yarn asbuild:release",
    "test": "node --test",
    "build": "(yarn test || zenity --error --timeout=2 --text='Test fail!' &) && (./build.sh || zenity --error --timeout=2 --text='Build fail!' &)",
    "build:watch": "yarn build; while inotifywait -r -e create -e modify -e move -e delete ./src ./test; do echo; yarn build; echo; done",
    "gen-cert": "test -e .cert.pem || openssl req -newkey rsa:2048 -new -nodes -x509 -days 999 -keyout .key.pem -out .cert.pem",
    "serve": "yarn gen-cert && PORT=3333 npx serve --ssl-cert=.cert.pem --ssl-key=.key.pem ./dist"
  },
  "devDependencies": {
    "assemblyscript": "^0.28.20"
  },
  "type": "module",
  "dependencies": {
    "minify": "^15.3.1",
    "terser": "^5.50.0"
  }
}
